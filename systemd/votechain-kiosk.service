[Unit]
Description=VoteChain V3 - Kiosk Terminal (Headless)
After=network.target votechain-backend.service systemd-modules-load.service dev-gpiomem0.device
Wants=dev-gpiomem0.device
Wants=votechain-backend.service
After=votechain-backend.service
Requires=votechain.service
ConditionPathExists=/dev/gpiomem0


[Service]
Type=simple
User=root
Group=root
# Kiosk often needs root for hardware (GPIO/SPI) access on older kernels
WorkingDirectory=/opt/votechain/kiosk

# Short sleep to allow devices/modules to settle
ExecStartPre=/bin/sleep 5

# Start kiosk with absolute path using python
ExecStart=/usr/bin/python3 /opt/votechain/kiosk/kiosk_main.py

# Backend URL to avoid discovery blocking on startup
Environment=BACKEND_URL=http://localhost:3000
TimeoutStartSec=60

# Restart Strategy
Restart=always
RestartSec=5
StartLimitIntervalSec=0

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=votechain-kiosk

[Install]
WantedBy=multi-user.target
