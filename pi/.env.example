# Supabase project details
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_service_role_key

# Permanent Ngrok static domain (from ngrok.com dashboard)
NGROK_DOMAIN=your_ngrok_static_domain.ngrok-free.app

# Ngrok Authtoken (from your ngrok dashboard)
NGROK_AUTHTOKEN=your_authtoken_here

# Local backend port (default: 3000)
PORT=3000

# Security Sync (Must match backend/.env)
AADHAAR_SALT="your-privacy-hashing-salt"
SERVER_PRIVATE_KEY="0xYourBackendWalletPrivateKey"
VOTING_CONTRACT_ADDRESS="0xYourDeployedContractAddress"
