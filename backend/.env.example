# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-service-role-key-here"
SUPABASE_ANON_KEY="your-anon-key-here"

# Blockchain Configuration
SERVER_PRIVATE_KEY="0xYourBackendWalletPrivateKeyHere"
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
VOTING_CONTRACT_ADDRESS="0xYourDeployedContractAddressHere"

# Admin and Security
ADMIN_SECRET="your-admin-login-secret"
AADHAAR_SALT="your-privacy-hashing-salt"

# Deployment Configuration (Optional)
# Set to 'true' to enable automatic systemd service restart after contract deployment
AUTO_RESTART="false"
